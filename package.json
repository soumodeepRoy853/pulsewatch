{
  "name": "pulsewatch",
  "version": "0.1.0",
  "description": "API reliability and incident management platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.10",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
